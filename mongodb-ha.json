{
  "title": "MongoDB ReplicaSet HA",
  "uid": "mongo-ha",
  "version": 1,
  "refresh": "5s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["mongodb", "replicaset"],
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Status",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "value_and_name", "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "expr": "mongodb_up{instance=\"mongo-primary\"}", "legendFormat": "mongo-primary", "refId": "A" },
        { "expr": "mongodb_up{instance=\"mongo-secondary1\"}", "legendFormat": "mongo-secondary1", "refId": "B" },
        { "expr": "mongodb_up{instance=\"mongo-secondary2\"}", "legendFormat": "mongo-secondary2", "refId": "C" }
      ]
    },
    {
      "id": 2,
      "title": "Connections",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "mongodb_connections{state=\"current\",instance=\"mongo-primary\"}", "legendFormat": "primary - current", "refId": "A" },
        { "expr": "mongodb_connections{state=\"current\",instance=\"mongo-secondary1\"}", "legendFormat": "secondary1 - current", "refId": "B" },
        { "expr": "mongodb_connections{state=\"current\",instance=\"mongo-secondary2\"}", "legendFormat": "secondary2 - current", "refId": "C" }
      ]
    },
    {
      "id": 3,
      "title": "Operation/sec",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(mongodb_op_counters_total{type=\"insert\",instance=\"mongo-primary\"}[1m])", "legendFormat": "insert", "refId": "A" },
        { "expr": "rate(mongodb_op_counters_total{type=\"query\",instance=\"mongo-primary\"}[1m])", "legendFormat": "query", "refId": "B" },
        { "expr": "rate(mongodb_op_counters_total{type=\"update\",instance=\"mongo-primary\"}[1m])", "legendFormat": "update", "refId": "C" },
        { "expr": "rate(mongodb_op_counters_total{type=\"delete\",instance=\"mongo-primary\"}[1m])", "legendFormat": "delete", "refId": "D" }
      ]
    },
    {
      "id": 4,
      "title": "Replication Lag ",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 30 }] }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "mongodb_mongod_replset_member_replication_lag{instance=\"mongo-secondary1\"}", "legendFormat": "secondary1 lag", "refId": "A" },
        { "expr": "mongodb_mongod_replset_member_replication_lag{instance=\"mongo-secondary2\"}", "legendFormat": "secondary2 lag", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "title": "Memory",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "mongodb_memory{type=\"resident\",instance=\"mongo-primary\"}", "legendFormat": "primary resident", "refId": "A" },
        { "expr": "mongodb_memory{type=\"resident\",instance=\"mongo-secondary1\"}", "legendFormat": "secondary1 resident", "refId": "B" },
        { "expr": "mongodb_memory{type=\"resident\",instance=\"mongo-secondary2\"}", "legendFormat": "secondary2 resident", "refId": "C" }
      ]
    },
    {
      "id": 6,
      "title": "Priority (1=PRIMARY, 2=SECONDARY, 6=UNKNOWN, 8=DOWN)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short",
          "mappings": [
            { "type": "value", "options": {
              "1": { "text": "PRIMARY", "color": "green" },
              "2": { "text": "SECONDARY", "color": "blue" },
              "6": { "text": "UNKNOWN", "color": "yellow" },
              "8": { "text": "DOWN", "color": "red" }
            }}
          ]
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "mongodb_mongod_replset_my_state{instance=\"mongo-primary\"}", "legendFormat": "mongo-primary state", "refId": "A" },
        { "expr": "mongodb_mongod_replset_my_state{instance=\"mongo-secondary1\"}", "legendFormat": "mongo-secondary1 state", "refId": "B" },
        { "expr": "mongodb_mongod_replset_my_state{instance=\"mongo-secondary2\"}", "legendFormat": "mongo-secondary2 state", "refId": "C" }
      ]
    }
  ]
}
